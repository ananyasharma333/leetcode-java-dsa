import java.util.HashSet;
import java.util.Set;

class Solution {
    public int totalNumbers(int[] digits) {
        Set<Integer> uniqueNumbers = new HashSet<>();
        int n = digits.length;
        
        // Iterate through all possible combinations of 3 distinct indices (k, j, i)
        // k: hundreds place, j: tens place, i: units place
        for (int i = 0; i < n; i++) {
            // Units digit must be even
            if (digits[i] % 2 != 0) {
                continue;
            }
            
            for (int j = 0; j < n; j++) {
                if (j == i) continue; // Cannot use the same position
                
                for (int k = 0; k < n; k++) {
                    if (k == i || k == j) continue; // Cannot reuse positions
                    
                    int hundreds = digits[k];
                    // No leading zeros allowed
                    if (hundreds == 0) {
                        continue;
                    }
                    
                    int tens = digits[j];
                    int ones = digits[i];
                    
                    int number = hundreds * 100 + tens * 10 + ones;
                    uniqueNumbers.add(number);
                }
            }
        }
        
        return uniqueNumbers.size();
    }
}
