/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private int matchingCount = 0;

    public int averageOfSubtree(TreeNode root) {
        matchingCount = 0;
        postOrder(root);
        return matchingCount;
    }

    // Returns an array of size 2: [sum of subtree, count of nodes in subtree]
    private int[] postOrder(TreeNode node) {
        if (node == null) {
            return new int[]{0, 0};
        }

        int[] left = postOrder(node.left);
        int[] right = postOrder(node.right);

        int subtreeSum = left[0] + right[0] + node.val;
        int subtreeCount = left[1] + right[1] + 1;

        if (node.val == subtreeSum / subtreeCount) {
            matchingCount++;
        }

        return new int[]{subtreeSum, subtreeCount};
    }
}
