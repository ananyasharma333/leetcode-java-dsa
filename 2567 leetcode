import java.util.Arrays;

class Solution {
    public int minimizeSum(int[] nums) {
        int n = nums.length;
        if (n <= 3) {
            return 0; // We can make all elements equal with at most two changes
        }

        Arrays.sort(nums); //

        // Option 1: Change the two smallest elements -> range becomes nums[n - 1] - nums[2]
        int changeTwoSmallest = nums[n - 1] - nums[2];

        // Option 2: Change the two largest elements -> range becomes nums[n - 3] - nums[0]
        int changeTwoLargest = nums[n - 3] - nums[0];

        // Option 3: Change one smallest and one largest -> range becomes nums[n - 2] - nums[1]
        int changeBothEnds = nums[n - 2] - nums[1];

        return Math.min(changeTwoSmallest, Math.min(changeTwoLargest, changeBothEnds)); //
    }
}
