class Solution {
    public int stoneGameVIII(int[] stones) {
        int n = stones.length;
        
        // Compute prefix sums in-place
        for (int i = 1; i < n; i++) {
            stones[i] += stones[i - 1];
        }
        
        // Base case: picking all elements up to index n - 1
        int ans = stones[n - 1];
        
        // DP backwards from n - 2 down to 1
        for (int i = n - 2; i >= 1; i--) {
            ans = Math.max(ans, stones[i] - ans);
        }
        
        return ans;
    }
}
