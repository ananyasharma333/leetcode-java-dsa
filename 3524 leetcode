class Solution {
    public long[] resultArray(int[] nums, int k) {
        long[] ans = new long[k];
        // dp[r] stores the number of valid subarrays ending at the current position with product % k == r
        long[] dp = new long[k];
        
        for (int num : nums) {
            long[] newDp = new long[k];
            int numMod = num % k;
            
            // 1. Start a new subarray with only the current element
            newDp[numMod] = 1;
            
            // 2. Extend all previous valid subarrays
            for (int i = 0; i < k; ++i) {
                if (dp[i] > 0) {
                    int newMod = (int) ((1L * i * numMod) % k);
                    newDp[newMod] += dp[i];
                }
            }
            
            // 3. Accumulate counts into the global result array
            for (int i = 0; i < k; ++i) {
                ans[i] += newDp[i];
            }
            
            dp = newDp;
        }
        
        return ans;
    }
}
