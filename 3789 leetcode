class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        // Strategy A: Only buy individual items for both needs
        long costA = (long) need1 * cost1 + (long) need2 * cost2;
        
        // Strategy B: Only buy bundle (Type 3) items to cover the max requirement
        long costB = (long) costBoth * Math.max(need1, need2);
        
        // Strategy C: Buy bundles for the overlapping amount, then individual items for the remainder
        int mn = Math.min(need1, need2);
        long costC = (long) costBoth * mn + (long) (need1 - mn) * cost1 + (long) (need2 - mn) * cost2;
        
        // Return the minimum cost among all three strategies
        return Math.min(costA, Math.min(costB, costC));
    }
}
