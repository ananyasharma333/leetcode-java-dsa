class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int[] freeCount = new int[n];

        for (int i = 0; i < n; i++) {
            int factorI = items[i][0];
            int count = 0;
            for (int j = 0; j < n; j++) {
                if (i != j && factorI % items[j][0] == 0) {
                    count++;
                }
            }
            freeCount[i] = count;
        }

        int[] dp = new int[budget + 1];

        for (int i = 0; i < n; i++) {
            int price = items[i][1];
            if (price > budget) {
                continue;
            }

            // 0/1 step: first copy grants 1 + freeCount[i] total copies
            for (int b = budget; b >= price; b--) {
                dp[b] = Math.max(dp[b], dp[b - price] + 1 + freeCount[i]);
            }

            // Unbounded step: extra copies grant 1 copy each
            for (int b = price; b <= budget; b++) {
                dp[b] = Math.max(dp[b], dp[b - price] + 1);
            }
        }

        return dp[budget];
    }
}
