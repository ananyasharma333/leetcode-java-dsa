import java.util.ArrayList;
import java.util.List;

class Solution {
    private static final long MOD = 1000000007;
    private long[][] table;

    public int numOfWays(int[] nums) {
        int n = nums.length;
        
        // 1. Precompute Pascal's triangle for combinations C(n, k)
        table = new long[n + 1][n + 1];
        for (int i = 0; i <= n; i++) {
            table[i][0] = 1;
            for (int j = 1; j <= i; j++) {
                table[i][j] = (table[i - 1][j - 1] + table[i - 1][j]) % MOD;
            }
        }

        // 2. Convert array to a List for easy sub-list splitting
        List<Integer> list = new ArrayList<>();
        for (int num : nums) {
            list.add(num);
        }

        // Subtract 1 because the problem asks for *reorderings* (excluding the original array)
        return (int)((dfs(list) - 1 + MOD) % MOD);
    }

    private long dfs(List<Integer> nums) {
        if (nums.size() <= 2) {
            return 1;
        }

        int root = nums.get(0);
        List<Integer> left = new ArrayList<>();
        List<Integer> right = new ArrayList<>();

        // Partition elements into left and right subtrees
        for (int i = 1; i < nums.size(); i++) {
            int val = nums.get(i);
            if (val < root) {
                left.add(val);
            } else {
                right.add(val);
            }
        }

        long leftWays = dfs(left);
        long rightWays = dfs(right);

        int L = left.size();
        int R = right.size();

        // Ways to combine left and right subtrees: C(L + R, L) * leftWays * rightWays
        long comb = table[L + R][L];
        
        long ans = (comb * leftWays) % MOD;
        ans = (ans * rightWays) % MOD;

        return ans;
    }
}
