import java.util.Arrays;

class Solution {
    public int findNonMinOrMax(int[] nums) {
        if (nums.length <= 2) {
            return -1;
        }
        
        // Sort the array to easily find elements between min and max
        Arrays.sort(nums);
        
        // Return the element at index 1 (neither min nor max)
        return nums[1];
    }
}
