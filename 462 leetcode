import java.util.Arrays;

class Solution {
    public int minMoves2(int[] nums) {
        // Sort the array to easily locate the median
        Arrays.sort(nums);
        
        int median = nums[nums.length / 2];
        int moves = 0;
        
        // Sum up the absolute differences from the median
        for (int num : nums) {
            moves += Math.abs(num - median);
        }
        
        return moves;
    }
}
