class Allocator {
    private int[] memory;
    private List<Integer>[] mIDToIndices;

    @SuppressWarnings("unchecked")
    public Allocator(int n) {
        memory = new int[n];
        // Constraints usually specify mID up to 1000
        mIDToIndices = new ArrayList[1001];
        for (int i = 0; i <= 1000; i++) {
            mIDToIndices[i] = new ArrayList<>();
        }
    }
    
    public int allocate(int size, int mID) {
        int consecutiveFree = 0;
        
        for (int i = 0; i < memory.length; i++) {
            if (memory[i] == 0) {
                consecutiveFree++;
            } else {
                consecutiveFree = 0;
            }
            
            // Found a valid contiguous block of required size
            if (consecutiveFree == size) {
                int startIndex = i - size + 1;
                for (int j = startIndex; j <= i; j++) {
                    memory[j] = mID;
                    mIDToIndices[mID].add(j);
                }
                return startIndex;
            }
        }
        
        return -1; // No suitable block found
    }
    
    public int freeMemory(int mID) {
        if (mID < 0 || mID >= mIDToIndices.length) return 0;
        
        List<Integer> indices = mIDToIndices[mID];
        int freedUnits = indices.size();
        
        for (int index : indices) {
            memory[index] = 0;
        }
        indices.clear();
        
        return freedUnits;
    }
}

