class Solution {
    public int maximumK(int[] nums) {
        int ans = -1; // Initialize with all bits set to 1 in two's complement
        
        for (int i = 0; i < nums.length; i++) {
            // Check if the element is misplaced
            if (nums[i] != i) {
                if (ans == -1) {
                    ans = nums[i];
                } else {
                    ans &= nums[i];
                }
            }
        }
        
        // If array is already sorted, ans will remain -1, return 0 as required.
        return ans == -1 ? 0 : ans;
    }
}
