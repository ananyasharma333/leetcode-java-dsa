class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder ans = new StringBuilder();
        int cnt = 0;
        
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            
            if (c == '(') {
                // If cnt > 0 before incrementing (or ++cnt > 1), it's an inner '('
                if (++cnt > 1) {
                    ans.append(c);
                }
            } else {
                // If cnt > 1 before decrementing (or --cnt > 0), it's an inner ')'
                if (--cnt > 0) {
                    ans.append(c);
                }
            }
        }
        
        return ans.toString();
    }
}
