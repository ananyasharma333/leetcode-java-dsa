class Solution {
    public int sumOfSquares(int[] nums) {
        int n = nums.length;
        int sum = 0;
        
        // Loop through each element (1-based index i + 1)
        for (int i = 0; i < n; i++) {
            int oneBasedIndex = i + 1;
            
            // Check if it's a special element
            if (n % oneBasedIndex == 0) {
                sum += nums[i] * nums[i];
            }
        }
        
        return sum;
    }
}
