import java.util.Arrays;
import java.util.PriorityQueue;

class Solution {
    public int[] getOrder(int[][] tasks) {
        int n = tasks.length;
        int[] result = new int[n];
        
        // augmentedTasks: [enqueueTime, processingTime, originalIndex]
        int[][] augmentedTasks = new int[n][3];
        for (int i = 0; i < n; i++) {
            augmentedTasks[i][0] = tasks[i][0];
            augmentedTasks[i][1] = tasks[i][1];
            augmentedTasks[i][2] = i;
        }
        
        // 1. Sort tasks primarily by enqueueTime
        Arrays.sort(augmentedTasks, (a, b) -> Integer.compare(a[0], b[0]));
        
        // 2. Min-heap ordered by:
        //    - Shortest processing time (task[1])
        //    - Smallest original index (task[2])
        PriorityQueue<int[]> minHeap = new PriorityQueue<>((a, b) -> {
            if (a[1] != b[1]) {
                return Integer.compare(a[1], b[1]);
            }
            return Integer.compare(a[2], b[2]);
        });
        
        long currTime = 0; // Use long to avoid overflow when adding large durations
        int taskIdx = 0;
        int resIdx = 0;
        
        // 3. Process until all tasks are pushed and executed
        while (resIdx < n) {
            // If the CPU is idle and heap is empty, jump time to the next task's arrival
            if (minHeap.isEmpty() && currTime < augmentedTasks[taskIdx][0]) {
                currTime = augmentedTasks[taskIdx][0];
            }
            
            // Add all tasks that have arrived by `currTime` into the heap
            while (taskIdx < n && augmentedTasks[taskIdx][0] <= currTime) {
                minHeap.offer(augmentedTasks[taskIdx]);
                taskIdx++;
            }
            
            // Execute the next task with the shortest processing time
            int[] currentTask = minHeap.poll();
            result[resIdx++] = currentTask[2];
            currTime += currentTask[1];
        }
        
        return result;
    }
}
