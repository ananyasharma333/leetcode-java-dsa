class Solution {
    private final int[] DAYS = new int[] {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    public int countDaysTogether(String arriveAlice, String leaveAlice, String arriveBob, String leaveBob) {
        int arriveAliceDays = getDays(arriveAlice);
        int leaveAliceDays = getDays(leaveAlice);
        int arriveBobDays = getDays(arriveBob);
        int leaveBobDays = getDays(leaveBob);

        // Overlap starts at the later arrival and ends at the earlier departure
        int startOverlap = Math.max(arriveAliceDays, arriveBobDays);
        int endOverlap = Math.min(leaveAliceDays, leaveBobDays);

        return Math.max(0, (endOverlap - startOverlap) + 1);
    }

    private int getDays(String date) {
        int month = Integer.parseInt(date.substring(0, 2));
        int day = Integer.parseInt(date.substring(3, 5));
        
        int totalDays = 0;
        for (int i = 1; i < month; i++) {
            totalDays += DAYS[i - 1];
        }
        return totalDays + day;
    }
}
