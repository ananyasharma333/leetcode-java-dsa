import java.util.Arrays;

class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        char[] chars = s.toCharArray();
        
        // cost[i][j] stores the minimum changes to make substring s[i...j] a semi-palindrome
        int[][] cost = new int[n][n];
        for (int len = 2; len <= n; len++) {
            for (int i = 0; i <= n - len; i++) {
                int j = i + len - 1;
                int minCost = Integer.MAX_VALUE;
                
                // Try all proper divisors d of the length
                for (int d = 1; d < len; d++) {
                    if (len % d == 0) {
                        int curCost = 0;
                        for (int offset = 0; offset < d; offset++) {
                            int l = i + offset;
                            int r = j - d + 1 + offset;
                            while (l < r) {
                                if (chars[l] != chars[r]) {
                                    curCost++;
                                }
                                l += d;
                                r -= d;
                            }
                        }
                        minCost = Math.min(minCost, curCost);
                    }
                }
                cost[i][j] = minCost;
            }
        }
        
        // dp[i][j] means minimum changes to partition the first i characters into j parts
        int[][] dp = new int[n + 1][k + 1];
        for (int i = 0; i <= n; i++) {
            Arrays.fill(dp[i], 1000000); // Initialize with a large value representing infinity
        }
        dp[0][0] = 0;
        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= Math.min(i, k); j++) {
                if (j == 1) {
                    dp[i][j] = cost[0][i - 1];
                } else {
                    for (int p = j - 1; p < i; p++) {
                        dp[i][j] = Math.min(dp[i][j], dp[p][j - 1] + cost[p][i - 1]);
                    }
                }
            }
        }
        
        return dp[n][k];
    }
}
