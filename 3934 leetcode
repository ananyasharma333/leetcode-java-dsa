import java.util.HashMap;
import java.util.Map;

class Solution {
    private static final long BASE1 = 100_003L;
    private static final long MOD1 = 1_000_000_007L;
    private static final long BASE2 = 1_000_003L;
    private static final long MOD2 = 1_000_000_009L;

    public int smallestUniqueSubarray(int[] nums) {
        int n = nums.length;
        int lo = 1, hi = n;
        int ans = n;

        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            if (hasUniqueOfLength(nums, mid)) {
                ans = mid;
                hi = mid - 1;
            } else {
                lo = mid + 1;
            }
        }

        return ans;
    }

    private boolean hasUniqueOfLength(int[] nums, int len) {
        int n = nums.length;
        if (len > n) return false;

        long h1 = 0, h2 = 0;
        long pow1 = 1, pow2 = 1;

        for (int i = 0; i < len; i++) {
            h1 = (h1 * BASE1 + nums[i]) % MOD1;
            h2 = (h2 * BASE2 + nums[i]) % MOD2;
            if (i > 0) {
                pow1 = (pow1 * BASE1) % MOD1;
                pow2 = (pow2 * BASE2) % MOD2;
            }
        }

        Map<Long, Integer> freq = new HashMap<>();
        freq.put(combine(h1, h2), 1);

        for (int i = len; i < n; i++) {
            int out = nums[i - len];
            int in = nums[i];

            h1 = (h1 - (out * pow1) % MOD1 + MOD1) % MOD1;
            h1 = (h1 * BASE1 + in) % MOD1;

            h2 = (h2 - (out * pow2) % MOD2 + MOD2) % MOD2;
            h2 = (h2 * BASE2 + in) % MOD2;

            long key = combine(h1, h2);
            freq.put(key, freq.getOrDefault(key, 0) + 1);
        }

        for (int count : freq.values()) {
            if (count == 1) {
                return true;
            }
        }
        return false;
    }

    private long combine(long h1, long h2) {
        return (h1 << 32) ^ h2;
    }
}
