import java.util.Arrays;

class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        long[] squares = new long[n];
        
        // Step 1: Compute the square of each element
        for (int i = 0; i < n; i++) {
            squares[i] = (long) nums[i] * nums[i];
        }
        
        // Step 2: Sort the squared values in ascending order
        Arrays.sort(squares);
        
        long score = 0;
        int minusCount = n / 2; // Number of elements to subtract
        
        // Step 3: Subtract the smallest half of the squares
        for (int i = 0; i < minusCount; i++) {
            score -= squares[i];
        }
        
        // Step 4: Add the remaining larger half of the squares
        for (int i = minusCount; i < n; i++) {
            score += squares[i];
        }
        
        return score;
    }
}
